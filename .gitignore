# Godot caches / per-machine state
game/.godot/
game/*.translation
*.tmp
*.import.tmp

# Build outputs (packaged builds are produced by tools/build/*.ps1; see README)
/build/
tools/forge/build/
dist/
game/export_cache/

# Local verification captures (curated evidence lives in docs/evidence/)
captures/
*.log
# AI Lab runs made with the documented commands (docs/AI_LAB.md, docs/evidence/lab/README.md)
/runs/

# Tool dependencies
tools/**/node_modules/
__pycache__/

# Agent worktrees and local tool state
.claude/

# per-build stamp written by tools/build/package.ps1 during export
game/build_info.json
