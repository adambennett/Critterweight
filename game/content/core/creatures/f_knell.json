  "movepool": {
    "sounding_jab": {"name": "Sounding Jab", "category": "strike", "role": "basic", "string": ["l1", "l2", "l3", "finisher"], "dash": "dash_attack",
      "short": "Jab, Port Hook, Deadweight, then the Rising Bell",
      "desc": "Knell's salvage-yard boxing: the Sounding Jab, the Port Hook and the heavy Deadweight, every blow building Haunted. Press again to keep the string going; the fourth press is the Rising Bell uppercut, which knocks the target down. Out of a dodge it is the Wake Breaker shoulder charge.",
      "styles": {
        "deep_sounding": {"name": "Deep Sounding", "desc": "Every punch builds half again as much Haunted.", "patch": [
          {"op": "mul", "path": "moves.l1.buildup", "value": 1.5}, {"op": "mul", "path": "moves.l2.buildup", "value": 1.5}, {"op": "mul", "path": "moves.l3.buildup", "value": 1.5},
          {"op": "mul", "path": "moves.finisher.buildup", "value": 1.5}]},
        "undertow_hook": {"name": "Undertow Hook", "desc": "The Deadweight drags the target a step in instead of knocking it away, so the Rising Bell is always in reach.", "patch": [
          {"op": "set", "path": "moves.l3.pull", "value": 0.6}]}},
      "ai": {"range": [0.0, 1.3]}},
    "anchor_fist": {"name": "Anchor Fist", "category": "strike", "role": "heavy", "use": "heavy", "charged": "heavy_charged", "hold": "charge",
      "short": "A weighted right hand; hold it to drop the Deep Anchor",
      "desc": "A slow right hand with the whole suit's ballast behind it. Hold the button to keep winding it up and release into the Deep Anchor, which hits harder the longer it was held. Neither swing cancels into anything unless it lands, so a whiff is a long, honest opening.",
      "styles": {
        "lead_weight": {"name": "Lead Weight", "desc": "The Deep Anchor knocks the target down.", "patch": [
          {"op": "set", "path": "moves.heavy_charged.knockdown", "value": true}]},
        "divers_brace": {"name": "Diver's Brace", "desc": "Both swings shrug off light hits on the way in.", "patch": [
          {"op": "set", "path": "moves.heavy.armor", "value": [[0.12, 0.4]]}, {"op": "set", "path": "moves.heavy.armor_level", "value": "lights"},
          {"op": "set", "path": "moves.heavy_charged.armor", "value": [[0.0, 0.4]]}, {"op": "set", "path": "moves.heavy_charged.armor_level", "value": "lights"}]}},
      "ai": {"range": [0.0, 1.5], "hold": [0.3, 0.9]}},
    "ghost_light": {"name": "Ghost Light", "category": "projectile", "use": "ability1",
      "short": "A slow lantern flame that follows its mark",
      "desc": "Knell lets a lantern flame go from his hand. It drifts at walking pace but turns after its target for over two seconds, and builds Haunted when it lands. Out-walk it sideways, guard it, or close in while it is still on its way.",
      "styles": {
        "long_wick": {"name": "Long Wick", "desc": "The flame burns twice as long and turns harder after its mark.", "patch": [
          {"op": "set", "path": "abilities.ability1.effects[type=projectile].life", "value": 4.4},
          {"op": "set", "path": "abilities.ability1.effects[type=projectile].homing_deg", "value": 95}]},
        "grave_lantern": {"name": "Grave Lantern", "desc": "The flame bursts where it ends, Haunting everyone within 1.4 metres.", "patch": [
          {"op": "set", "path": "abilities.ability1.effects[type=projectile].on_expire", "value": {"type": "area", "radius": 1.4, "damage": 3, "knockback": 1.5,
