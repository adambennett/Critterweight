        "keel_over": {"name": "Keel Over", "desc": "The counter-snap knocks the attacker off their feet instead of just shoving them away.", "patch": [
          {"op": "set", "path": "abilities.ability2.effects[type=counter_stance].counter.knockdown", "value": true}]},
        "sea_wall": {"name": "Sea Wall", "desc": "While he is anchored, a wall of water in front of him washes away incoming projectiles, so the stance stops shots too.", "patch": [
          {"op": "append", "path": "abilities.ability2.effects", "value": {"t": 0.15, "type": "destroy_projectiles", "radius": 1.8, "cone_deg": 150, "every": 0.1, "until": 2.4}}]}},
      "ai": {"range": [0.0, 2.4], "when": [{"self_poise_below": 0.4}, {"target_heavy": true}]}},
