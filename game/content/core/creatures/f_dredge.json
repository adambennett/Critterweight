  "movepool": {
    "claw_snap": {"name": "Claw Snap", "category": "strike", "role": "basic", "string": ["l1", "l2", "l3", "finisher"], "dash": "dash_attack",
      "short": "Snip, backhand, double clamp, then the Bilge Pump",
      "desc": "Dredge's claw string: the Cutter Snip, the Backhand Claw sweep and the Double Clamp, then the Bilge Pump shove that splats a fighter against the cage wall. Press again to keep it going; out of a dodge it is the Scuttle Check shell charge, stronger out of a sideways scuttle. Every claw builds Soaked, and the Double Clamp holds a Soaked fighter longer.",
      "styles": {
        "pistol_shrimp": {"name": "Pistol Shrimp", "desc": "The Bilge Pump fires a cavitation snap: a small brine shockwave around the claw that also clips anyone beside the target.", "patch": [
          {"op": "append", "path": "moves.finisher.on_hit", "value": {"do": [{"type": "area", "radius": 1.1, "damage": 3, "knockback": 3.0, "stun": 0.2, "poise": 8,
            "element": "brine", "buildup": 15, "vfx": "dredge_cavitation"}]}}]},
        "tidepool_grip": {"name": "Tidepool Grip", "desc": "The Backhand Claw and the Double Clamp drag the target back in instead of shoving it away, so the whole string stays in claw range.", "patch": [
          {"op": "set", "path": "moves.l2.pull", "value": 0.4}, {"op": "set", "path": "moves.l3.pull", "value": 0.4}]}},
      "ai": {"range": [0.0, 1.4]}},
    "crusher_slam": {"name": "Crusher Slam", "category": "strike", "role": "heavy", "use": "heavy", "charged": "heavy_charged", "hold": "charge",
      "short": "Overhead claw slam and its floor wave; hold for the Hull Breaker",
      "desc": "The crusher claw rises overhead, armoured on the way up, and slams down, sending a 3.5-metre brine wave along the floor that trips Soaked fighters. Hold the button to keep the claw raised and release into the Hull Breaker: a guard-crushing slam that leaves a brine puddle. The raised claw is a long, readable wind-up: step off its line or punish the recovery.",
      "styles": {
        "riptide_wave": {"name": "Riptide Wave", "desc": "The slam's floor wave rolls five metres and soaks much harder, so it trips Soaked fighters from further away and soaks the rest on the way.", "patch": [
          {"op": "set", "path": "moves.heavy.effects[type=area].length", "value": 5.0},
          {"op": "set", "path": "moves.heavy.effects[type=area].buildup", "value": 20}]},
        "keelhaul": {"name": "Keelhaul", "desc": "The Hull Breaker hooks its target: it hauls them in and always knocks them flat, but the charged slam comes down slower.", "patch": [
          {"op": "set", "path": "moves.heavy_charged.knockdown", "value": true},
          {"op": "set", "path": "moves.heavy_charged.pull", "value": 0.5},
          {"op": "time_scale", "path": "moves.heavy_charged", "value": 1.12}]}},
      "ai": {"range": [0.0, 1.5], "hold": [0.4, 1.0]}},
    "tide_spit": {"name": "Tide Spit", "category": "projectile", "use": "ability1",
      "short": "A lobbed glob of seawater that leaves a brine puddle",
      "desc": "Dredge spits a glob of seawater in an arc at his target, up to seven metres away: it soaks whoever it hits and leaves a brine puddle for five seconds where it lands. The arc is slow and the glob can be reflected: sidestep it, or keep moving.",
      "styles": {
        "skipping_spit": {"name": "Skipping Spit", "desc": "The glob skips once off the floor before it bursts, carrying on past a fighter who stepped back and leaving its puddle further along.", "patch": [
          {"op": "set", "path": "abilities.ability1.effects[type=projectile].bounce", "value": 1},
          {"op": "set", "path": "abilities.ability1.effects[type=projectile].life", "value": 2.4}]},
        "brine_bomb": {"name": "Brine Bomb", "desc": "The glob bursts where it lands in a 1.6-metre splash that soaks and shoves everyone around it, on top of the puddle.", "patch": [
          {"op": "set", "path": "abilities.ability1.effects[type=projectile].on_expire", "value": [
            {"type": "area", "radius": 1.6, "damage": 4, "knockback": 3.5, "stun": 0.25, "poise": 8, "element": "brine", "buildup": 30, "vfx": "dredge_spit_splash"},
            {"type": "zone", "kind": "brine_puddle", "radius": 1.2, "duration": 5}]}]}},
      "ai": {"range": [3.0, 7.0]}},
    "anchor_drop": {"name": "Anchor Drop", "category": "counter", "use": "ability2",
      "short": "A planted counter stance: strike him and get snapped",
      "desc": "Dredge drops his weight and plants both claws for two and a half seconds: he cannot walk, shrugs off every hit and takes half the knockback, and any strike that lands on him is answered with a claw snap. Grabs and projectiles beat it, so drop anchor when someone commits to a melee rush.",
