  "movepool": {
    "slap": {"name": "Slap", "category": "strike", "role": "basic", "string": ["l1", "l2", "l3", "finisher"], "dash": "dash_attack",
      "short": "Slap, Double Slap, Headbonk, then the Static Cling",
      "desc": "Jitters' quick hopping string: two stubby slaps, a Headbonk that bounces it back out of reach, and the Static Cling discharge on the fourth press, worth extra Hype when it sets Jolted off. Every hit builds Jolted. Out of a dodge it is the Pinball spin, which banks off the cage wall back at its target. The slaps are short: a guard stops the string, and the Static Cling's press-in is easy to step away from.",
      "styles": {
        "static_hands": {"name": "Static Hands", "desc": "Every slap, the Headbonk and the Static Cling build half again as much Jolted.", "patch": [
          {"op": "mul", "path": "moves.l1.buildup", "value": 1.5}, {"op": "mul", "path": "moves.l2.buildup", "value": 1.5}, {"op": "mul", "path": "moves.l3.buildup", "value": 1.5},
          {"op": "mul", "path": "moves.finisher.effects[type=area].buildup", "value": 1.5}]},
        "pinball_wizard": {"name": "Pinball Wizard", "desc": "The Pinball dash strike banks off the cage wall twice instead of once.", "patch": [
          {"op": "set", "path": "moves.dash_attack.effects[type=charge].bounce", "value": 2}]}},
      "ai": {"range": [0.0, 1.1]}},
    "squash": {"name": "Squash", "category": "strike", "role": "heavy", "use": "heavy", "charged": "heavy_charged", "hold": "charge",
      "short": "A body-slam leap; hold to load the Super Squash",
      "desc": "Jitters hops onto its target and lands with a static thump that also catches anyone near the landing spot; a slam on the head bonks for extra damage. Hold the button to coil up and release into the Super Squash: a higher, longer leap that crushes guards and knocks its target up. Both leave Jitters in the air for a long moment, so a sidestep or a quick hit on the landing beats them.",
      "styles": {
        "hair_trigger": {"name": "Hair Trigger", "desc": "Charges in half the time, but the Super Squash leaps shorter (2.4 metres instead of 3).", "patch": [
          {"op": "mul", "path": "moves.heavy.charge_time", "value": 0.5},
          {"op": "set", "path": "moves.heavy_charged.effects[type=leap].distance", "value": 2.4}]},
        "aftershock": {"name": "Aftershock", "desc": "The Super Squash's landing leaves a crackling static field (1.4 metres, 2.5 seconds) that flinches anyone who steps in.", "patch": [
          {"op": "append", "path": "moves.heavy_charged.effects[type=leap].on_land", "value": {"type": "zone", "kind": "static_field", "radius": 1.4, "duration": 2.5,
            "owner_immune": true, "vfx": "jitters_static_field"}}]}},
      "ai": {"range": [0.8, 2.4], "hold": [0.3, 0.9]}},
    "arc_lash": {"name": "Arc Lash", "category": "projectile", "use": "ability1",
      "short": "A slow homing orb that pulses if it times out",
      "desc": "Jitters flicks a crackling orb off its antenna that drifts after its target, turning to follow a sidestep, and builds a lot of Jolted when it lands. If it runs out of time instead, it bursts in a small static pulse. It is slow: outpace it, guard it, or send it back with a reflect.",
      "styles": {
        "twin_lash": {"name": "Twin Lash", "desc": "Two orbs in a 40° fork, each with 60% of the damage and build-up: harder to walk around.", "patch": [
          {"op": "set", "path": "abilities.ability1.effects[type=projectile].count", "value": 2},
