  "movepool": {
    "wing_snap": {"name": "Wing Snap", "category": "strike", "role": "basic", "string": ["l1", "l2", "l3", "finisher"], "dash": "dash_attack",
      "short": "Wing, beak, kick, then the Tailspin; dives from the air",
      "desc": "Gusto's hit-and-run string: a wing snap, a double beak peck, a scissor kick that launches a Winded target, and the Tailspin finisher that spins everyone off him. Out of a dodge it is the Skid Kick slide, which trips a Winded or Soaked fighter; from the hover it is the Dive Peck. Every hit is light, so a raised guard soaks the whole string.",
      "styles": {
        "featherweight": {"name": "Featherweight", "desc": "The wing, beak and kick come out faster but cost a little more stamina.", "patch": [
          {"op": "time_scale", "path": "moves.l1", "value": 0.88}, {"op": "time_scale", "path": "moves.l2", "value": 0.88}, {"op": "time_scale", "path": "moves.l3", "value": 0.88},
          {"op": "mul", "path": "moves.l1.stamina", "value": 1.25}, {"op": "mul", "path": "moves.l2.stamina", "value": 1.25}, {"op": "mul", "path": "moves.l3.stamina", "value": 1.25}]},
        "gale_kick": {"name": "Gale Kick", "desc": "The Scissor Kick launches any fighter into the air, and a Winded one higher still.", "patch": [
          {"op": "set", "path": "moves.l3.on_hit", "value": [{"do": [{"type": "launch", "amount": 2.6}]}, {"if": {"target_status": "gale"}, "do": [{"type": "launch", "amount": 1.4}]}]}]}},
      "ai": {"range": [0.0, 1.5]}},
    "crosswind_slash": {"name": "Crosswind Slash", "category": "strike", "role": "heavy", "use": "heavy", "charged": "heavy_charged", "hold": "charge",
      "short": "Both wings cross; hold for the Downdraft stomp",
      "desc": "Both wings sweep in and cross at chest height, and the gust behind them shoves the target back even when the wings miss. Hold the button to crouch and charge, then release into the Downdraft: a leap onto the target and a two-footed stomp that bursts on landing (from the hover it comes at once). The charge is slow and the leap easy to read: step aside and punish the landing.",
      "styles": {
        "inward_gale": {"name": "Inward Gale", "desc": "The gust behind the wings pulls the target back in instead of shoving it away, keeping it in reach of the string.", "patch": [
          {"op": "set", "path": "moves.heavy.effects[type=push].type", "value": "pull"}]},
        "updraft_stomp": {"name": "Updraft Stomp", "desc": "The Downdraft's landing burst spreads wider and throws everyone around it into the air.", "patch": [
          {"op": "set", "path": "moves.heavy_charged.effects[type=leap].on_land[0].launch", "value": 3.6},
          {"op": "mul", "path": "moves.heavy_charged.effects[type=leap].on_land[0].radius", "value": 1.25}]}},
      "ai": {"range": [0.0, 1.6], "hold": [0.3, 0.9]}},
    "gust_bomb": {"name": "Gust Bomb", "category": "projectile", "use": "ability1",
      "short": "Spit a knot of air that bursts and blows fighters away",
      "desc": "Gusto spits a ball of compressed air at his target, up to eight metres. It knocks back whatever it hits and bursts at the end of its flight, blowing away anyone near and building Winded. It flies straight and can be reflected: sidestep it, or stay clear of where it will pop.",
      "styles": {
        "vacuum_bomb": {"name": "Vacuum Bomb", "desc": "The burst sucks fighters in toward the pop instead of blowing them away.", "patch": [
          {"op": "set", "path": "abilities.ability1.effects[type=projectile].on_expire.kb_dir", "value": "toward"}]},
        "updraft_bomb": {"name": "Updraft Bomb", "desc": "The burst throws fighters up into the air instead of blowing them away.", "patch": [
          {"op": "set", "path": "abilities.ability1.effects[type=projectile].on_expire.launch", "value": 4.6},
          {"op": "set", "path": "abilities.ability1.effects[type=projectile].on_expire.knockback", "value": 1.5}]}},
      "ai": {"range": [1.6, 7.5]}},
    "hang_time": {"name": "Hang Time", "category": "utility", "use": "ability2",
      "short": "Rise two metres and hover above the fray",
      "desc": "One strong wing beat lifts Gusto two metres for 1.2 seconds: he can steer, ground zones cannot touch him, and his strike string and heavy become dives from the air. Any other move drops him out of the hover. Shots and anti-air strikes still reach him, and the landing is open to a punish.",
      "styles": {
        "thermal_rider": {"name": "Thermal Rider", "desc": "Rides a thermal: hovers half again as long and steers faster.", "patch": [
          {"op": "set", "path": "abilities.ability2.effects[type=hover].duration", "value": 1.8},
          {"op": "set", "path": "abilities.ability2.effects[type=hover].speed", "value": 4.2}]},
        "liftoff_gust": {"name": "Lift-off Gust", "desc": "The take-off beat blasts the floor: fighters next to Gusto are blown away as he rises.", "patch": [
          {"op": "append", "path": "abilities.ability2.effects", "value": {"t": 0.15, "type": "area", "radius": 1.6, "damage": 2, "knockback": 5.5, "stun": 0.2, "poise": 6,
