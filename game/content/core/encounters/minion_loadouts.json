    {"id": "scrapling_leaky_pipe", "type": "minion_loadout", "base": "npc_scrapling", "name": "Leaky Pipe Scrapling", "tags": ["minion", "scrapling", "element:sludge"],
     "patches": [{"op": "set", "path": "moves.l1.element", "value": "sludge"}, {"op": "set", "path": "moves.l1.buildup", "value": 15},
