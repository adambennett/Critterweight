    {"id": "blister_sludge", "type": "minion_loadout", "base": "npc_blister", "name": "Blister", "patches": [], "tags": ["minion", "blister", "element:sludge"]},
    {"id": "blister_ember", "type": "minion_loadout", "base": "npc_blister", "name": "Ember Blister", "tags": ["minion", "blister", "element:scorch"],
