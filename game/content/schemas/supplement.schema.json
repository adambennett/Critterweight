{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Campaign supplement or side effect (content/<pkg>/supplements)",
 "type": "object",
 "required": [
  "id",
  "type",
  "name"
 ],
 "properties": {
  "_doc": {
   "type": "string"
  },
  "override": {
   "type": "boolean"
  },
  "id": {
   "type": "string",
   "pattern": "^([a-z0-9_]+:)?(sup|se)_[a-z0-9_]+$"
  },
  "type": {
   "enum": [
    "supplement",
    "side_effect"
   ]
  },
  "name": {
   "type": "string",
   "minLength": 1
  },
  "rarity": {
   "enum": [
    "otc",
    "prescription",
    "black_market",
    "banned"
   ]
  },
  "stack": {
   "type": "integer",
   "minimum": 1,
   "maximum": 5
  },
  "gear": {
   "type": "boolean"
  },
  "consumable": {
   "type": "boolean"
  },
  "cosmetic": {
   "type": "boolean"
  },
  "not_offered": {
   "type": "boolean"
  },
  "tags": {
   "$ref": "#/$defs/tags"
  },
  "effect": {
   "type": "string"
  },
  "side_effect": {
   "type": "string"
  },
  "label": {
   "type": "string"
  },
  "price": {
   "type": "integer",
   "minimum": 0
  },
  "weight": {
   "type": "number",
   "minimum": 0
  },
  "apply": {
   "$ref": "#/$defs/apply"
  },
  "on_pick": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/effect"
   }
  }
 },
 "additionalProperties": false,
 "$defs": {
  "patch": {
   "type": "object",
   "required": [
    "op",
    "path"
   ],
   "properties": {
    "op": {
     "enum": [
      "set",
      "add",
      "mul",
      "min",
      "max",
      "append",
      "remove",
      "merge",
      "time_scale"
     ]
    },
    "path": {
     "type": "string",
     "minLength": 1
    },
    "value": {},
    "default": {
     "type": "number"
    },
    "phase": {
     "enum": [
      "all",
      "startup"
     ]
    },
    "create": {
     "type": "boolean"
    },
    "spread": {
     "type": "boolean"
    },
    "when": {
     "enum": [
      "always",
      "solo",
      "coop",
      "tag"
     ]
    }
   },
   "additionalProperties": false
  },
  "mod": {
   "type": "object",
   "required": [
    "key"
   ],
   "properties": {
    "key": {
     "type": "string",
     "minLength": 1
    },
    "mul": {
     "type": "number"
    },
    "add": {
     "type": "number"
    },
    "set": {},
    "when": {
     "enum": [
      "always",
      "solo",
      "coop",
      "tag"
     ]
    }
   },
   "additionalProperties": false
  },
  "hook": {
   "type": "object",
   "required": [
    "on",
    "do"
   ],
   "properties": {
    "on": {
     "type": "string"
    },
    "if": {
     "type": "object"
    },
    "do": {
     "type": "array",
     "maxItems": 16,
     "items": {
      "type": "object",
      "required": [
       "type"
      ]
     }
    },
    "chance": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "cooldown": {
     "type": "number",
     "minimum": 0
    },
    "max_uses": {
     "type": "integer",
     "minimum": 0
    },
    "every": {
     "type": "number",
     "minimum": 0.05
    },
    "id": {
     "type": "string"
    },
    "source": {
     "type": "string"
    },
    "when": {
     "enum": [
      "always",
      "solo",
      "coop",
      "tag"
     ]
    }
   },
   "additionalProperties": false
  },
  "apply": {
   "type": "object",
   "properties": {
    "patches": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/patch"
     }
    },
    "mods": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/mod"
     }
    },
    "run": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/mod"
     }
    },
    "hooks": {
     "type": "array",
     "maxItems": 16,
     "items": {
      "$ref": "#/$defs/hook"
     }
    },
    "statuses": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id"
      ]
     }
    },
    "fight_rolls": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "key",
       "min",
       "max"
      ]
     }
    }
   },
   "additionalProperties": false
  },
  "effect": {
   "type": "object",
   "required": [
    "op"
   ],
   "properties": {
    "op": {
     "enum": [
      "hp",
      "hp_pct",
      "max_hp",
      "scrip",
      "clout",
      "hype_carry",
      "hype_carry_set",
      "grant_supplement",
      "side_effect",
      "remove_supplement",
      "remove_side_effects",
      "technique_pick",
      "reward_pick",
      "run_mods",
      "run_patches",
      "run_hooks",
      "next_fight",
      "bet",
      "boss_mod",
      "fight",
      "cosmetic",
      "coupon",
      "flag",
      "nothing",
      "consumable",
      "quip",
      "stat"
     ]
    }
   }
  },
  "tags": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z_]+(:[a-z_]+)?$"
   }
  }
 }
}
