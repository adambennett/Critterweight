{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Fighter technique or build direction (content/<pkg>/techniques)",
 "oneOf": [
  {
   "type": "object",
   "required": [
    "id",
    "type",
    "fighter",
    "name",
    "apply"
   ],
   "properties": {
    "_doc": {
     "type": "string"
    },
    "override": {
     "type": "boolean"
    },
    "id": {
     "type": "string",
     "pattern": "^([a-z0-9_]+:)?tech_[a-z0-9_]+$"
    },
    "type": {
     "const": "technique"
    },
    "fighter": {
     "type": "string"
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "build": {
     "type": "string"
    },
    "tags": {
     "$ref": "#/$defs/tags"
    },
    "effect": {
     "type": "string"
    },
    "apply": {
     "$ref": "#/$defs/apply"
    }
   },
   "additionalProperties": false
  },
  {
   "type": "object",
   "required": [
    "id",
    "type",
    "fighter",
    "name",
    "techniques"
   ],
   "properties": {
    "_doc": {
     "type": "string"
    },
    "override": {
     "type": "boolean"
    },
    "id": {
     "type": "string",
     "pattern": "^([a-z0-9_]+:)?build_[a-z0-9_]+$"
    },
    "type": {
     "const": "build"
    },
    "fighter": {
     "type": "string"
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "techniques": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    },
    "tags": {
     "$ref": "#/$defs/tags"
    },
    "blurb": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 ],
 "$defs": {
  "patch": {
   "type": "object",
   "required": [
    "op",
    "path"
   ],
   "properties": {
    "op": {
     "enum": [
      "set",
      "add",
      "mul",
      "min",
      "max",
      "append",
      "remove",
      "merge",
      "time_scale"
     ]
    },
    "path": {
     "type": "string",
     "minLength": 1
    },
    "value": {},
    "default": {
     "type": "number"
    },
    "phase": {
     "enum": [
      "all",
      "startup"
     ]
    },
    "create": {
     "type": "boolean"
    },
    "spread": {
     "type": "boolean"
    },
    "when": {
     "enum": [
      "always",
      "solo",
      "coop",
      "tag"
     ]
    }
   },
   "additionalProperties": false
  },
  "mod": {
   "type": "object",
   "required": [
    "key"
   ],
   "properties": {
    "key": {
     "type": "string",
     "minLength": 1
    },
    "mul": {
     "type": "number"
    },
    "add": {
     "type": "number"
    },
    "set": {},
    "when": {
     "enum": [
      "always",
      "solo",
      "coop",
      "tag"
     ]
    }
   },
   "additionalProperties": false
  },
  "hook": {
   "type": "object",
   "required": [
    "on",
    "do"
   ],
   "properties": {
    "on": {
     "type": "string"
    },
    "if": {
     "type": "object"
    },
    "do": {
     "type": "array",
     "maxItems": 16,
     "items": {
      "type": "object",
      "required": [
       "type"
      ]
     }
    },
    "chance": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "cooldown": {
     "type": "number",
     "minimum": 0
    },
    "max_uses": {
     "type": "integer",
     "minimum": 0
    },
    "every": {
     "type": "number",
     "minimum": 0.05
    },
    "id": {
     "type": "string"
    },
    "source": {
     "type": "string"
    },
    "when": {
     "enum": [
      "always",
      "solo",
      "coop",
      "tag"
     ]
    }
   },
   "additionalProperties": false
  },
  "apply": {
   "type": "object",
   "properties": {
    "patches": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/patch"
     }
    },
    "mods": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/mod"
     }
    },
    "run": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/mod"
     }
    },
    "hooks": {
     "type": "array",
     "maxItems": 16,
     "items": {
      "$ref": "#/$defs/hook"
     }
    },
    "statuses": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id"
      ]
     }
    },
    "fight_rolls": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "key",
       "min",
       "max"
      ]
     }
    }
   },
   "additionalProperties": false
  },
  "effect": {
   "type": "object",
   "required": [
    "op"
   ],
   "properties": {
    "op": {
     "enum": [
      "hp",
      "hp_pct",
      "max_hp",
      "scrip",
      "clout",
      "hype_carry",
      "hype_carry_set",
      "grant_supplement",
      "side_effect",
      "remove_supplement",
      "remove_side_effects",
      "technique_pick",
      "reward_pick",
      "run_mods",
      "run_patches",
      "run_hooks",
      "next_fight",
      "bet",
      "boss_mod",
      "fight",
      "cosmetic",
      "coupon",
      "flag",
      "nothing",
      "consumable",
      "quip",
      "stat"
     ]
    }
   }
  },
  "tags": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z_]+(:[a-z_]+)?$"
   }
  }
 }
}
