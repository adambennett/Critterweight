{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "critterweight/arena",
  "title": "Arena layout",
  "description": "See docs/ARENAS_AND_EDITOR.md. Format 2: a base id (gullet, drydock, crusher, rooftop or '<mod>:<base>') plus boundary size, layout props and markers. Positions are metres on the arena floor [x, y, z]; yaw is degrees (0 faces +Z). Legacy format 1 (shape bases octagon/square/circle/platform with spawns [x, z, yaw]) is still accepted. Base arenas also carry a 'base_def' block.",
  "type": "object",
  "required": ["id", "name", "base"],
  "properties": {
    "id": {"type": "string", "pattern": "^([a-z0-9_]+:)?[a-z0-9_]+$", "maxLength": 64},
    "name": {"type": "string", "minLength": 1, "maxLength": 40},
    "base": {"anyOf": [
      {"enum": ["octagon", "square", "circle", "platform", "gullet", "drydock", "crusher", "rooftop"]},
      {"type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$"}
    ]},
    "variant": {"type": "string", "pattern": "^[a-z0-9_]*$", "maxLength": 32},
    "format": {"type": "integer", "minimum": 1, "maximum": 2},
    "size": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "number", "minimum": 3.0, "maximum": 30.0}},
    "radius": {"type": "number", "minimum": 2.5, "maximum": 12.0},
    "wall_height": {"type": "number", "minimum": 0, "maximum": 4.0},
    "ringout": {"type": "boolean"},
    "theme": {"type": "string", "maxLength": 32},
    "gravity_mult": {"type": "number", "minimum": 0.3, "maximum": 2.0},
    "author": {"type": "string", "maxLength": 40},
    "description": {"type": "string", "maxLength": 400},
    "version": {"type": "integer", "minimum": 1},
    "override": {"type": "boolean"},
    "example": {"type": "boolean"},
    "modes": {"type": "array", "maxItems": 16, "items": {"type": "string", "pattern": "^[a-z0-9_:]{2,40}$"}},
    "flags": {"type": "object", "additionalProperties": {"type": ["boolean", "number", "string"]}},
    "removed_builtins": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 48}},
    "spawns": {"type": "array", "maxItems": 16, "description": "Format 1 only: [x, z] or [x, z, yaw_deg].", "items": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number", "minimum": -720, "maximum": 720}}},
    "props": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/prop_item"}},
    "hazards": {"type": "array", "maxItems": 16, "items": {"type": "object", "required": ["type", "pos"]}},
    "markers": {"type": "object", "additionalProperties": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/marker_item"}}},
    "base_def": {"$ref": "#/$defs/base_def"}
  },
  "$defs": {
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -50, "maximum": 50}},
    "prop_item": {
      "type": "object",
      "required": ["type", "pos"],
      "properties": {
        "type": {"type": "string", "pattern": "^([a-z0-9_]+:)?[a-z0-9_]+$", "maxLength": 64},
        "id": {"type": "string", "maxLength": 48},
        "pos": {"$ref": "#/$defs/vec3"},
        "pos2": {"$ref": "#/$defs/vec3"},
        "yaw": {"type": "number", "minimum": -720, "maximum": 720},
        "scale": {"type": "number", "minimum": 0.25, "maximum": 4.0},
        "params": {"type": "object"}
      }
    },
    "marker_item": {"anyOf": [
      {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number", "minimum": -50, "maximum": 50}},
      {"type": "object", "required": ["pos"], "properties": {
        "pos": {"type": "array", "minItems": 2, "maxItems": 3, "description": "[x, y, z], or the format-1 floor form [x, z]", "items": {"type": "number", "minimum": -50, "maximum": 50}},
        "yaw": {"type": "number", "minimum": -720, "maximum": 720},
        "team": {"type": "integer", "minimum": -1, "maximum": 3},
        "size": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 20}}
      }}
    ]},
    "base_def": {
      "type": "object",
      "required": ["shape", "size"],
      "properties": {
        "id": {"type": "string", "pattern": "^([a-z0-9_]+:)?[a-z0-9_]+$"},
        "name": {"type": "string", "maxLength": 40},
        "shape": {"enum": ["octagon", "rect", "notched_rect", "circle"]},
        "style": {"type": "string", "maxLength": 32},
        "size": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "number", "minimum": 3, "maximum": 30}},
        "size_min": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "number", "minimum": 3, "maximum": 30}},
        "size_max": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "number", "minimum": 3, "maximum": 30}},
        "size_step": {"type": "number", "minimum": 0.05, "maximum": 5},
        "notch": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 10}},
        "wall_height": {"type": "number", "minimum": 0, "maximum": 6},
        "open_edges": {"type": "boolean"},
        "allow_pits": {"type": "boolean"},
        "quirks": {"type": "object"},
        "hazards": {"type": "array", "maxItems": 16, "items": {"type": "object", "required": ["id", "type"]}},
        "areas": {"type": "array", "maxItems": 16, "items": {"type": "object", "required": ["type"]}},
        "builtins": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/prop_item"}},
        "variants": {"type": "object"},
        "default_variant": {"type": "string"},
        "ringout": {"type": "object"},
        "palette": {"type": "object"}
      }
    }
  }
}
