{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "critterweight/prop",
  "title": "Arena prop / marker catalog entry",
  "description": "One entry of the arena editor palette (content 'props/*.json'). Sizes in metres: footprint [x, z] (circle: [diameter]), height y. See docs/ARENAS_AND_EDITOR.md#prop-catalog for every behaviour and its params.",
  "type": "object",
  "required": ["id", "name", "class"],
  "properties": {
    "id": {"type": "string", "pattern": "^([a-z0-9_]+:)?[a-z0-9_]+$", "maxLength": 64},
    "name": {"type": "string", "minLength": 1, "maxLength": 40},
    "class": {"enum": ["obstacle", "wall", "hazard", "pickup", "marker", "floor"]},
    "cost": {"type": "integer", "minimum": 0, "maximum": 50},
    "palette": {"type": "boolean"},
    "tab": {"enum": ["obstacles", "walls", "hazards", "pickups", "markers"]},
    "description": {"type": "string", "maxLength": 300},
    "element": {"enum": ["", "scorch", "brine", "static", "sludge", "grit", "gale", "scrap", "spectral"]},
    "icon": {"type": "string", "maxLength": 32},
    "override": {"type": "boolean"},
    "footprint": {
      "type": "object",
      "properties": {
        "shape": {"enum": ["box", "circle", "pair", "none"]},
        "size": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "number", "minimum": 0.05, "maximum": 20}}
      }
    },
    "height": {"type": "number", "minimum": 0, "maximum": 10},
    "body": {"enum": ["none", "static", "static_nosplat", "dynamic", "bag", "ramp"]},
    "solid": {"type": "boolean"},
    "hazard": {"type": "boolean"},
    "splat": {"type": "boolean"},
    "hp": {"type": "number", "minimum": 0, "maximum": 1000},
    "behaviour": {"enum": ["static", "crate", "fan", "steam_vent", "electric_plate", "spring_pad", "bumper", "pit", "drain_pair", "heavy_bag", "pickup", "ramp", "mat", "railing", "marker", "block"]},
    "params": {"type": "object"},
    "timed": {"type": "object", "properties": {
      "period": {"type": "number", "minimum": 0.5, "maximum": 120},
      "telegraph": {"type": "number", "minimum": 0, "maximum": 10},
      "active": {"type": "number", "minimum": 0, "maximum": 60}
    }},
    "on_destroy": {"type": "object"},
    "touch": {"type": "object"},
    "push": {"type": "object"},
    "bounce": {"type": "object"},
    "pickup": {"type": "object", "properties": {
      "kind": {"enum": ["health", "hype"]},
      "amount": {"type": "number", "minimum": 0, "maximum": 100},
      "respawn": {"type": "number", "minimum": 1, "maximum": 600}
    }},
    "rotation_step": {"type": "number", "minimum": 1, "maximum": 180},
    "max_per_layout": {"type": "integer", "minimum": 0, "maximum": 32},
    "marker": {"type": "object", "properties": {
      "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
      "max": {"type": "integer", "minimum": 1, "maximum": 24},
      "min": {"type": "integer", "minimum": 0, "maximum": 24},
      "teams": {"type": "boolean"},
      "team_max": {"type": "integer", "minimum": 1, "maximum": 8},
      "size": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 20}}
    }},
    "visual": {"type": "string", "maxLength": 64}
  }
}
