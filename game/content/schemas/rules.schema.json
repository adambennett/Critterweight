{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "critterweight/rules",
  "title": "Match rules preset",
  "description": "See docs/MODDING.md#rules. Validated again semantically by RulesValidator (combinations).",
  "type": "object",
  "required": ["id", "name", "mode"],
  "properties": {
    "id": {"type": "string", "pattern": "^([a-z0-9_]+:)?[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 40},
    "mode": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "override": {"type": "boolean"}
  }
}
