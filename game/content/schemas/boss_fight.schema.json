{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Boss fight data (content/<pkg>/boss_fights): phases, telegraphed attacks, arena interplay",
 "type": "object",
 "required": [
  "id",
  "type",
  "creature",
  "name",
  "phases"
 ],
 "properties": {
  "_doc": {
   "type": "string"
  },
  "override": {
   "type": "boolean"
  },
  "id": {
   "type": "string",
   "pattern": "^([a-z0-9_]+:)?fight_[a-z0-9_]+$"
  },
  "type": {
   "const": "boss_fight"
  },
  "creature": {
   "type": "string"
  },
  "name": {
   "type": "string"
  },
  "act": {
   "type": "integer",
   "minimum": 0,
   "maximum": 3
  },
  "arena": {
   "type": "string"
  },
  "standin_stats": {
   "type": "object"
  },
  "phase2_at": {
   "type": "number",
   "minimum": 0.05,
   "maximum": 0.95
  },
  "dazed": {
   "type": "object",
   "properties": {
    "duration": {
     "type": "number",
     "minimum": 0.5
    },
    "damage_taken": {
     "type": "number",
     "minimum": 1
    },
    "throw_mult": {
     "type": "number",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "target_rotate": {
   "type": "number",
   "minimum": 1
  },
  "intro_line": {
   "type": "string"
  },
  "defeat_line": {
   "type": "string"
  },
  "phases": {
   "type": "array",
   "minItems": 1,
   "maxItems": 2,
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "attacks"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "leash": {
      "type": "object",
      "properties": {
       "anchor": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "number"
        }
       },
       "radius": {
        "type": "number",
        "minimum": 1
       },
       "stumble": {
        "type": "number",
        "minimum": 0
       }
      },
      "additionalProperties": false
     },
     "hazards": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "kind"
       ],
       "properties": {
        "kind": {
         "type": "string"
        },
        "every": {
         "type": "number",
         "minimum": 0.5
        },
        "count": {
         "type": "integer",
         "minimum": 1,
         "maximum": 12
        },
        "duration": {
         "type": "number",
         "minimum": 0
        }
       },
       "additionalProperties": true
      }
     },
     "remove_hazards": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "reposition": {
      "type": "object",
      "properties": {
       "after_damage": {
        "type": "number",
        "minimum": 1
       },
       "attack": {
        "type": "string"
       }
      },
      "additionalProperties": false
     },
     "attack_gap": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "number",
       "minimum": 0
      }
     },
     "speed_mult": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 3
     },
     "transition": {
      "type": "object",
      "properties": {
       "invuln": {
        "type": "number",
        "minimum": 0
       },
       "line": {
        "type": "string"
       }
      },
      "additionalProperties": false
     },
     "element_cycle": {
      "type": "object",
      "properties": {
       "every": {
        "type": "number",
        "minimum": 1
       },
       "order": {
        "type": "array",
        "minItems": 2,
        "items": {
         "type": "string"
        }
       }
      },
      "additionalProperties": false
     },
     "attacks": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "id",
        "name",
        "telegraph",
        "actions"
       ],
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "weight": {
         "type": "number",
         "minimum": 0
        },
        "range": {
         "type": "array",
         "minItems": 2,
         "maxItems": 2,
         "items": {
          "type": "number"
         }
        },
        "cooldown": {
         "type": "number",
         "minimum": 0
        },
        "telegraph": {
         "type": "number",
         "minimum": 0.5
        },
        "recovery": {
         "type": "number",
         "minimum": 0
        },
        "aim": {
         "enum": [
          "target",
          "self",
          "center",
          "away"
         ]
        },
        "max_reach": {
         "type": "number",
         "minimum": 0
        },
        "track": {
         "type": "boolean"
        },
        "only_forced": {
         "type": "boolean"
        },
        "requires": {
         "type": "object"
        },
        "decal": {
         "type": "object",
         "properties": {
          "shape": {
           "enum": [
            "circle",
            "cone",
            "line",
            "ring",
            "square"
           ]
          },
          "radius": {
           "type": "number"
          },
          "cone_deg": {
           "type": "number"
          },
          "length": {
           "type": "number"
          },
          "width": {
           "type": "number"
          },
          "at": {
           "enum": [
            "aim",
            "self"
           ]
          },
          "element": {
           "type": "string"
          }
         },
         "additionalProperties": false
        },
        "actions": {
         "type": "array",
         "minItems": 1,
         "maxItems": 16,
         "items": {
          "type": "object",
          "required": [
           "type"
          ],
          "properties": {
           "t": {
            "type": "number",
            "minimum": 0
           },
           "type": {
            "type": "string"
           }
          }
         }
        }
       },
       "additionalProperties": false
      }
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false,
 "$defs": {
  "patch": {
   "type": "object",
   "required": [
    "op",
    "path"
   ],
   "properties": {
    "op": {
     "enum": [
      "set",
      "add",
      "mul",
      "min",
      "max",
      "append",
      "remove",
      "merge",
      "time_scale"
     ]
    },
    "path": {
     "type": "string",
     "minLength": 1
    },
    "value": {},
    "default": {
     "type": "number"
    },
    "phase": {
     "enum": [
      "all",
      "startup"
     ]
    },
    "create": {
     "type": "boolean"
    },
    "spread": {
     "type": "boolean"
    },
    "when": {
     "enum": [
      "always",
      "solo",
      "coop",
      "tag"
     ]
    }
   },
   "additionalProperties": false
  },
  "mod": {
   "type": "object",
   "required": [
    "key"
   ],
   "properties": {
    "key": {
     "type": "string",
     "minLength": 1
    },
    "mul": {
     "type": "number"
    },
    "add": {
     "type": "number"
    },
    "set": {},
    "when": {
     "enum": [
      "always",
      "solo",
      "coop",
      "tag"
     ]
    }
   },
   "additionalProperties": false
  },
  "hook": {
   "type": "object",
   "required": [
    "on",
    "do"
   ],
   "properties": {
    "on": {
     "type": "string"
    },
    "if": {
     "type": "object"
    },
    "do": {
     "type": "array",
     "maxItems": 16,
     "items": {
      "type": "object",
      "required": [
       "type"
      ]
     }
    },
    "chance": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "cooldown": {
     "type": "number",
     "minimum": 0
    },
    "max_uses": {
     "type": "integer",
     "minimum": 0
    },
    "every": {
     "type": "number",
     "minimum": 0.05
    },
    "id": {
     "type": "string"
    },
    "source": {
     "type": "string"
    },
    "when": {
     "enum": [
      "always",
      "solo",
      "coop",
      "tag"
     ]
    }
   },
   "additionalProperties": false
  },
  "apply": {
   "type": "object",
   "properties": {
    "patches": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/patch"
     }
    },
    "mods": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/mod"
     }
    },
    "run": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/mod"
     }
    },
    "hooks": {
     "type": "array",
     "maxItems": 16,
     "items": {
      "$ref": "#/$defs/hook"
     }
    },
    "statuses": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id"
      ]
     }
    },
    "fight_rolls": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "key",
       "min",
       "max"
      ]
     }
    }
   },
   "additionalProperties": false
  },
  "effect": {
   "type": "object",
   "required": [
    "op"
   ],
   "properties": {
    "op": {
     "enum": [
      "hp",
      "hp_pct",
      "max_hp",
      "scrip",
      "clout",
      "hype_carry",
      "hype_carry_set",
      "grant_supplement",
      "side_effect",
      "remove_supplement",
      "remove_side_effects",
      "technique_pick",
      "reward_pick",
      "run_mods",
      "run_patches",
      "run_hooks",
      "next_fight",
      "bet",
      "boss_mod",
      "fight",
      "cosmetic",
      "coupon",
      "flag",
      "nothing",
      "consumable",
      "quip",
      "stat"
     ]
    }
   }
  },
  "tags": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z_]+(:[a-z_]+)?$"
   }
  }
 }
}
