; Engine configuration file for CRITTERWEIGHT (working title).
; See AGENTS.md at the repository root for build/test/run commands.

config_version=5

[application]

config/name="Critterweight"
config/description="Physical creature cage fighting."
config/version="0.1.0"
run/main_scene="res://src/app/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Critterweight"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=0
boot_splash/bg_color=Color(0.07, 0.06, 0.09, 1)
boot_splash/show_image=false
config/icon="res://assets/ui/icon.svg"

[autoload]

Log="*res://src/core/log.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="fighters"
3d_physics/layer_3="projectiles"
3d_physics/layer_4="debris"
3d_physics/layer_5="props"
3d_physics/layer_6="triggers"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=6
3d/default_gravity=9.81
jolt_physics_3d/simulation/velocity_steps=10
jolt_physics_3d/simulation/position_steps=2

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.09, 1)
textures/default_filters/anisotropic_filtering_level=3
