  "lines": [
    {
      "id": "tut18_tut_m_string_intro",
      "speaker": "granny",
      "voice": "coach_buck",
      "template": "{basic}: {basic_name}. Press again as each one lands. The last one's the finisher.",
      "parts": [
        {
          "token": "basic"
        },
        {
          "token": "basic_name"
        },
        {
          "clip": "tut18_tut_m_string_intro_a"
        }
      ]
    },
    {
      "id": "tut18_tut_m_string_hint",
      "speaker": "granny",
      "voice": "coach_buck",
      "template": "Plant your feet. Tap {basic}, let it land, tap again, all the way to the finisher.",
      "parts": [
        {
          "clip": "tut18_tut_m_string_hint_a"
        },
        {
          "token": "basic"
        },
        {
          "clip": "tut18_tut_m_string_hint_b"
        }
      ]
    },
    {
      "id": "tut18_tut_m_string_rush",
      "speaker": "granny",
      "voice": "coach_buck",
      "template": "Easy. Tap, let it land, tap again. Rush it and the next one cancels the last.",
      "parts": [
        {
          "clip": "tut18_tut_m_string_rush"
        }
      ]
    },
    {
      "id": "tut18_tut_m_string_success",
      "speaker": "granny",
      "voice": "coach_buck",
      "template": "That's your string, finisher and all. When in doubt, do that.",
      "parts": [
        {
          "clip": "tut18_tut_m_string_success"
        }
      ]
    },
    {
      "id": "tut18_tut_m_string_skip_success",
      "speaker": "granny",
      "voice": "coach_buck",
      "template": "No basic strike in your loadout. Moving on.",
      "parts": [
        {
          "clip": "tut18_tut_m_string_skip_success"
        }
      ]
    },
    {
      "id": "tut18_tut_m_charge_intro",
      "speaker": "granny",
      "voice": "coach_buck",
      "template": "{charge}: {charge_name}. Tap it for the quick one. Hold it to wind up the big one.",
